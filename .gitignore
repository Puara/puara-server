# build files and dependencies
/node_modules
.build
.data

# ignore all environment config files except default
/config/env-*
!/config/env-default.yaml

# junk files
.DS_Store
Thumbs.db

# TLS certificates
/**/*.pem

# compiled puara-gestures addon
/native/build

# your own touch surfaces (surfaces/README.md): kept out of git until one is
# contributed back as a shipped surface in surfaces/
/surfaces/local/*
!/surfaces/local/README.md
