{
  "name": "puara-server",
  "description": "Browser-based audience interaction system for the Satosphère — soundworks + Puara OSC namespace",
  "authors": [
    "Société des arts technologiques (SAT)"
  ],
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run clean && sass src/styles:.build/public/css && soundworks-build -b",
    "clean": "soundworks-build -D",
    "dev": "npm run build && (concurrently -i -p \"none\" \"npm run watch:inspect server\" \"soundworks-build -b -w\" \"npm run watch:sass\")",
    "lint": "npx eslint src",
    "start": "node .build/server.js",
    "bridge": "node .build/clients/puara-bridge.js",
    "watch": "soundworks-build -p",
    "watch:inspect": "soundworks-build -i -p",
    "watch:sass": "sass --watch src/styles:.build/public/css"
  },
  "dependencies": {
    "@ircam/devicemotion": "^1.3.1",
    "@ircam/sc-components": "^3.8.0",
    "@soundworks/core": "^5.0.0",
    "@soundworks/helpers": "^5.0.0",
    "@soundworks/plugin-checkin": "^5.0.0",
    "@soundworks/plugin-platform-init": "^5.0.0",
    "lit": "^3.1.3",
    "node-osc": "^11.0.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@ircam/eslint-config": "^2.0.1",
    "@soundworks/build": "^5.0.0",
    "@types/node": "^22.10.10",
    "@types/web": "^0.0.199",
    "concurrently": "^8.2.2",
    "eslint": "^9.18.0",
    "sass": "^1.77.1"
  }
}
